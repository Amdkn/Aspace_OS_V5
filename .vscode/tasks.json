{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "V5: Doctor & Self-Heal Environment",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.vscode/doctor.ps1"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "runOptions": { "runOn": "folderOpen" }
    },
    {
      "label": "V5: Factory Deterministic Gate (checks.ps1)",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/02_Factory/checks.ps1"],
      "problemMatcher": []
    },
    {
      "label": "V5: Factory Mission Control Status (DeepSeek 3-Question Panel)",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/02_Factory/factory.ps1", "status"],
      "problemMatcher": []
    },
    {
      "label": "V5: Graphify Update (No LLM / Instant)",
      "type": "shell",
      "command": "${workspaceFolder}/00_Memoire/.venv/Scripts/graphify.exe",
      "args": ["update", "."],
      "problemMatcher": []
    },
    {
      "label": "V5: Memory Recall Test (WikiLLM + OKF)",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/00_Memoire/hooks/recall.ps1"],
      "problemMatcher": []
    },
    {
      "label": "V5: Herdr Status & Terminals",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-Command", "herdr-app status; hc ls"],
      "problemMatcher": []
    },
    {
      "label": "V5: WikiLLM Lint Check (Orphans & Log Integrity)",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-Command", "git status -s; Select-String -Path 00_Memoire/bundle/index.md -Pattern 'concepts/.*\\.md' -AllMatches | ForEach-Object { $_.Matches.Value }"],
      "problemMatcher": []
    }
  ]
}
