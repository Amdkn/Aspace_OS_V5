[Unit]
Description=A'Space Dream Daemon (SUBSTITUTION du daemon RigInfinity) — boucle H3 00h-05h, D-N052 R4
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Le daemon est lance par le coordinateur (pas un cron) ; il s'arrete seul a 05h.
ExecStart=/usr/bin/python3 /home/hatch/workspace/v5-r4/01_Forkable/FKB00_Runtime/00_A0_Core/aspace-dream-daemon/src/dream_daemon.py --v5 /home/hatch/workspace/v5-r4 --snapshot /tmp/factory-r4-night-snapshot.sqlite --state-dir /home/hatch/workspace/v4-factory/evidence/D-N052/r4/night --tz America/New_York
Restart=on-failure
RestartSec=30
StartLimitBurst=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aspace-dream-daemon

[Install]
WantedBy=multi-user.target
