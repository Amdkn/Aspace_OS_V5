      "license": "Apache-2.0",
      "sovereign_mirror": "Amdkn/PathFM"
    },
    {
      "pillar": "4_Internal_Calibration_Jury_Google",
      "ids": [
        "google/tabfm-1.1.0-pytorch",
        "google/timesfm-3.0-pytorch"
