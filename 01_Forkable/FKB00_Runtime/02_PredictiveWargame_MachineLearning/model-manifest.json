      "specs": "TabFM (24 ICL blocks, /classification & /regression) + TimesFM 3.0 (20L, 16H, Variate Attention, patch 32->64)",
      "weight_size": "1.65 GB + 1.32 GB",
      "license": "Non-Commercial",
      "sovereign_mirror": "Amdkn/tabfm-1.1.0-pytorch & Amdkn/timesfm-3.0-pytorch"
    }
