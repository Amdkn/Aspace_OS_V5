{
  "defaultProvider": "freellmapi",
  "defaultModel": "auto",
  "defaultThinkingLevel": "high",
  "collapseChangelog": true,
  "enableSkillCommands": true,
  "shellPath": "C:/Program Files/Git/bin/bash.exe",
  "externalEditor": "code --wait",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 24000
  },
  "prompts": [
    "./prompts"
  ],
  "extensions": [
    "./extensions"
  ]
}
